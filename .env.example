# EconIntel Environment Variables
# Copy this file to .env.local and fill in your actual values
# NEVER COMMIT .env.local TO GITHUB - it contains secrets!

# ========================================
# FRONTEND (Public - Safe to Expose)
# ========================================

# Your EdgeOne domain where backend functions run
NEXT_PUBLIC_API_URL=https://your-domain.edgeone.app

# Your production domain for CORS validation
NEXT_PUBLIC_ALLOWED_ORIGIN=https://your-domain.com

# Supabase details (if using REST API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here


# ========================================
# BACKEND (Server-Side Only - KEEP SECRET!)
# ========================================
# These should ONLY be set in:
# 1. .env.local (local development)
# 2. Vercel Dashboard → Settings → Environment Variables
# NEVER put these in .env.example!

# OpenRouter API key for LLM calls
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# JWT secret for signing tokens (32+ bytes recommended)
JWT_SECRET=your-jwt-secret-minimum-32-bytes-long-replace-this-with-secure-value

# EdgeOne environment variables (if running functions there)
# These are set in EdgeOne dashboard, not here
