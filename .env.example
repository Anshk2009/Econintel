# EconIntel Environment Variables
# Set in the EdgeOne dashboard (Environment Variables) and as GitHub Actions
# secrets — NEVER in a file. This is a reference list only; never commit real values.

# ── EdgeOne edge functions (functions/*.js) ──
# >= 32 characters, random. The functions refuse to start with a shorter one.
JWT_SECRET=minimum-32-characters-random-string
SUPABASE_URL=https://your-project.supabase.co
# The ONLY Supabase key the functions use: the new-format secret key
# (sb_secret_…). It bypasses RLS, which is ON for every table with no policies.
# Not a JWT, so EdgeOne stores it (it refuses the legacy eyJ… service_role key).
# Without it every function fails at startup with a named error.
SUPABASE_SECRET_KEY=sb_secret_your-key
# Comma-separated. The FIRST entry is the canonical site URL: it builds the
# OAuth redirect URIs and is sent as Access-Control-Allow-Origin.
ALLOWED_ORIGIN=https://econintel.edgeone.app
# NVIDIA build.nvidia.com — chat generation AND every embedding. One key, one
# quota shared by every user: 40 requests/minute, 10,000/day.
NVIDIA_API_KEY=nvapi-your-key
# OAuth — optional. Unset, the buttons say "That login method is not set up yet".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Password-reset email via Resend — optional. Still on Resend's test sender,
# which only delivers to the Resend account owner (see README).
RESEND_API_KEY=

# ── GitHub Actions secrets (.github/workflows/) ──
# NVIDIA_API_KEY and SUPABASE_URL as above, plus:
# The ingesters WRITE to `documents`, and RLS is on, so they need the
# service-role key (GitHub, unlike EdgeOne, stores the legacy JWT form fine).
SUPABASE_SERVICE_ROLE_KEY=
# check-retrieval.mjs only READS, through match_documents, with the anon key.
SUPABASE_ANON_KEY=your-supabase-anon-key
# Optional open-data sources — each skips cleanly when its key is unset.
FRED_API_KEY=
DATA_GOV_IN_KEY=
# SEC EDGAR asks for a contact in the User-Agent; RSS feeds get it too.
INGEST_CONTACT=EconIntel econintelai@gmail.com
