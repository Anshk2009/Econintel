# EconIntel Environment Variables
# These are set in the EdgeOne dashboard (Environment Variables), NOT in a file.
# This is a reference list only — never commit real values.

# ── EdgeOne edge functions (server-side only, KEEP SECRET) ──
JWT_SECRET=minimum-32-bytes-random-string
OPENROUTER_API_KEY=sk-or-v1-your-key-here
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
ALLOWED_ORIGIN=https://econintel.edgeone.app
# Optional: base64-wrapped service_role key. When set, the functions use it
# instead of the anon key (required once RLS is enabled). EdgeOne refuses to
# store the raw JWT, hence the base64 wrapper.
SUPABASE_SERVICE_KEY_B64=
# NVIDIA (build.nvidia.com) — powers BOTH chat generation and every embedding
# (live question + ingestion). One key, one account, one quota. Without it, chat
# falls back to the OpenRouter models below and RAG retrieval fails open.
# Also needed as a GitHub Actions secret of the same name for the ingest jobs.
NVIDIA_API_KEY=nvapi-your-key

# ── RAG ingestion (GitHub Actions secrets, see .github/workflows/) ──
# Embeddings use NVIDIA_API_KEY above (was OPENROUTER_EMBED_KEY before 2026-08-21).
# SUPABASE_URL and SUPABASE_ANON_KEY above are reused by the ingesters.
INGEST_CONTACT=EconIntel econintelai@gmail.com
